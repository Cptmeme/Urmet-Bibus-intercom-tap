		(uuid "5b662b2c-4d20-4d24-a09d-b092ecdb5940")
	)
	(text "2. Bus load 22.5V / 1.1M = 20uA. Urmet spec for the"
		(exclude_from_sim no)
		(at 177.8 184.15 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "6b9d71cc-4790-401c-b788-4448b3f6e31e")
	)
	(text "   Get data off over Wi-Fi (UDP), not the serial port."
		(exclude_from_sim no)
		(at 177.8 175.26 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "84662078-8a0f-4093-813a-708684ab8ee9")
	)
	(text "3. ADC pins MUST be on ADC1 - ADC2 is dead when Wi-Fi"
		(exclude_from_sim no)
		(at 177.8 204.47 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "8c3ebdf5-c147-409f-8932-a25031505a60")
	)
	(text "   1V at the ADC, centred on 1.65V. 3.2Hz high-pass."
		(exclude_from_sim no)
		(at 177.8 259.08 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "a595967a-e9ce-46a9-81fa-211927ed0b4f")
	)
	(text "   1705/954 bracket is 1.6mA standby on L1/L2, so this"
		(exclude_from_sim no)
		(at 177.8 190.5 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "bb92f7ad-0775-41ae-991a-ff759b3d991e")
	)
	(text "SAFETY / DESIGN NOTES"
		(exclude_from_sim no)
		(at 177.8 149.86 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "bdf3c179-b25b-464b-a8ef-e06ee88c913c")
	)
	(text "1. Board GND is bus L2 - this tap is NOT isolated."
		(exclude_from_sim no)
		(at 177.8 157.48 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "c2f99c4d-e6fc-488c-8f3e-638429bb3a02")
	)
	(text "   sense C1/C2 with the separate opto board instead."
		(exclude_from_sim no)
		(at 177.8 237.49 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "d6eb947d-29ee-4c0a-8c12-7c1fd498a050")
	)
	(text "   is on. ESP32: GPIO34 / 35 / 36 (input-only)."
		(exclude_from_sim no)
		(at 177.8 210.82 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "df75e961-3bba-40ac-899d-72363a5b13b1")
	)
	(text "   with a multimeter that C1/C2 shares a reference with"
		(exclude_from_sim no)
		(at 177.8 226.06 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "ec16a52b-44e7-4d6c-9912-74f5ed653f61")
	)
	(text "5. Ch A window 0-34V (1/11 divider, unity buffer)."
		(exclude_from_sim no)
		(at 177.8 246.38 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "fd61773f-6d4d-4141-9adf-1e08356db43b")
	)
